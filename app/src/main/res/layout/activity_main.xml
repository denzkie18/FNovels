<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/navBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:padding="6dp"
        android:elevation="10dp"
        android:background="@drawable/bottom_nav_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/indicator"
            android:layout_width="84dp"
            android:layout_height="52dp"
            android:background="@drawable/nav_indicator" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tabHome"
                android:layout_width="84dp"
                android:layout_height="52dp"
                android:padding="13dp"
                android:src="@drawable/ic_home_outline"
                android:contentDescription="Home"
                android:tint="@color/nav_icon_tint"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/tabExplore"
                android:layout_width="84dp"
                android:layout_height="52dp"
                android:padding="13dp"
                android:src="@drawable/ic_explore_outline"
                android:contentDescription="Explore"
                android:tint="@color/nav_icon_tint"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
